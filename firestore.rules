rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'prodyutacharya7@gmail.com',
          'bipulbala64@gmail.com'
        ];
    }

    // অ্যাপ/ওয়েবসাইট লগইন প্রোফাইল — নিজের ডকুমেন্ট নিজে পড়তে/লিখতে পারবে,
    // অ্যাডমিন প্যানেল (AdminScreen.js) সবার তালিকা দেখতে পারবে
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow list, get: if isAdmin();
    }

    // ওয়েবসাইটের mya-cloud-sync.js — users/{uid}/data/kundaliProfiles-এ সেভ-করা
    // কুণ্ডলী প্রোফাইল রাখে; উপরের match শুধু users/{uid} ডকুমেন্ট কভার করে,
    // সাব-কালেকশন আলাদা নিয়ম ছাড়া ডিফল্টে বন্ধ থাকত (সিঙ্ক নীরবে ব্যর্থ হতো)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ওয়েবসাইটের চেকআউট পপআপগুলোর মূল্য/প্রোমো কোড — সবাই পড়তে পারবে,
    // শুধু অ্যাডমিন লিখতে পারবে (pricing-admin.html)
    match /pricing/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // js/social-data.js-এর লাইভ Google/JustDial/Facebook/YouTube রিভিউ ও
    // ফলোয়ার সংখ্যা — সবাই পড়তে পারবে (data-sd badge instant আপডেটের জন্য),
    // শুধু অ্যাডমিন লিখতে পারবে (social-admin.html)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ওয়েবসাইটের প্রিমিয়াম চেকআউট (kundali.html ইত্যাদি) — গ্রাহক লগইন ছাড়াই
    // অর্ডার তৈরি করেন (শুধু ইমেইল/ফোন দিয়ে), তাই create-এ auth লাগবে না।
    // কিন্তু অর্ডারে জন্মকুষ্ঠি/প্রশ্নের মতো ব্যক্তিগত তথ্য থাকে বলে read/list
    // শুধু অ্যাডমিনের জন্য — অন্য কেউ অন্যের অর্ডার পড়তে/সম্পাদনা করতে পারবে না।
    // hasAll চেকটা ন্যূনতম ফর্ম-জাঙ্ক/স্প্যাম আটকানোর জন্য, নিরাপত্তার মূল
    // স্তর read-restriction-ই।
    match /orders/{orderId} {
      // ⚠️ ২০২৬-০৯-২৯ — দুটো শর্ত যোগ (আসল তিন পথ — কুণ্ডলী, মিলন, বুকিং — এগুলো মেনেই লেখে):
      //   · uid থাকলে সেটা লেখকের নিজের (বা null) — নইলে যে কেউ অন্যের "আমার রিপোর্ট"-এ
      //     ভুয়া অর্ডার ঢোকাতে পারত।
      //   · status থাকলে কেবল 'new' — "প্রস্তুত" (ready) অবস্থা দেয় কেবল অ্যাডমিন।
      // পেমেন্ট সত্যি কি না তা নিয়ম জানতে পারে না — সেটা অ্যাডমিনের "যাচাই" বোতাম
      // (functions: adminVerifyRazorpayPayment)। scripts/verify-firestore-rules.js দেখে।
      allow create: if request.resource.data.keys().hasAll(['pid', 'email', 'ts'])
                    && request.resource.data.email is string
                    && request.resource.data.ts is number
                    && (!('uid' in request.resource.data)
                        || request.resource.data.uid == null
                        || (request.auth != null && request.resource.data.uid == request.auth.uid))
                    && (!('status' in request.resource.data)
                        || request.resource.data.status == 'new');
      // ── ক্রেতা নিজের অর্ডার দেখতে পারেন ──
      // আগে কেবল অ্যাডমিন পড়তে পারতেন, তাই কেউ ₹৫০১ দিয়ে কিনে ২৪ ঘণ্টা
      // অপেক্ষা করলেও অ্যাপে/সাইটে কিছুই দেখতে পেতেন না — টাকা গেল, কোথায়
      // দাঁড়িয়ে আছে জানার উপায় নেই। এখন নিজের uid-এর অর্ডার পড়া যায়।
      // ⚠️ কেবল **পড়া** — status বা কোনো ফিল্ড ক্রেতা বদলাতে পারেন না,
      // নইলে যে কেউ নিজের অর্ডারকে 'done' বা দাম বদলে দিতে পারতেন।
      // ⚠️ list-এর জন্য ক্লায়েন্টকে where('uid','==',...) দিয়েই কোয়েরি
      // করতে হয়; অন্য কোনো কোয়েরি Firestore নিজেই ফিরিয়ে দেবে।
      // ⚠️ `read` ইচ্ছাকৃতভাবে — এটি get **ও** list দুটোই ঢাকে। আলাদা করে
      // `allow list: if isAdmin()` লিখলে ক্রেতার where('uid','==',…) কোয়েরিটাই
      // আটকে যেত, আর "আমার রিপোর্ট" পাতাটা কখনো কিছু দেখাত না।
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      // ₹১৫০১-এ ফোন/হোয়াটসঅ্যাপে পরামর্শ থাকে, সেটা অ্যাপের বাইরে হয় —
      // তাই ক্রেতাকে নিজের সময় ও নম্বর জানাতে দিতে হয়। কিন্তু **কেবল
      // `booking` ঘরটাই** — affectedKeys().hasOnly() ছাড়া যে কেউ নিজের
      // অর্ডারের status 'done' বা দাম বদলে দিতে পারতেন।
      allow update: if isAdmin()
                    || (request.auth != null
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booking']));
      allow delete: if isAdmin();

      // ── তৈরি হওয়া প্রিমিয়াম রিপোর্ট ──
      // Gemini-র লেখা এখানে, অর্ডার-ডকুমেন্টে নয়: ওই ডকুমেন্টে ইতিমধ্যেই
      // printHtml (৯০০ KB পর্যন্ত) থাকে আর Firestore-এর সীমা ১ MiB —
      // একসঙ্গে রাখলে লেখাটাই ব্যর্থ হতো, আর .catch() সেটা নীরবে গিলে
      // ফেলত: জ্যোতিষী ভাবতেন পাঠানো হয়েছে, ক্রেতা কিছুই পেতেন না।
      // সাব-কালেকশনের নিজের ১ MiB বাজেট আছে।
      // ⚠️ get() একটা বাড়তি পড়া, কিন্তু মালিকানা যাচাইয়ের অন্য উপায় নেই —
      // uid সাব-ডকুমেন্টে নকল করে রাখলে দুটো জায়গা একদিন সরে যেত।
      // ⚠️ লেখা কেবল অ্যাডমিন — ক্রেতা নিজের রিপোর্ট বদলাতে পারেন না।
      match /report/{docId} {
        allow read: if isAdmin()
                    || (request.auth != null
                        && get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    // ── Play Billing-এ কেনা অধিকার ──
    // পাঠক নিজের অধিকার **পড়তে** পারেন (অ্যাপ দেখায় কোনটা কেনা আছে),
    // কিন্তু লিখতে পারেন না — লেখে কেবল verifyPlayPurchase ফাংশন, Admin
    // SDK দিয়ে, Google-এর কাছে টোকেন যাচাই করার পরে।
    // ⚠️ ক্লায়েন্টকে লেখার অধিকার দিলে যাচাইয়ের গোটা ব্যবস্থাটাই অর্থহীন
    // হতো — যে কেউ নিজের ঘরে "কেনা হয়েছে" লিখে দিতে পারতেন।
    match /entitlements/{uid}/items/{orderId} {
      allow read, list: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── কেনা সাধারণ PDF-এর খাতা (ওয়েবসাইটের js/mya-purchases.js, ২০২৬-০৯-২৭) ──
    // কুণ্ডলী/মিলন ₹১০১, সংখ্যা/বর্ষফল ₹৫১, পঞ্জিকা ₹২১ — PDF নয়, কেবল জন্মতথ্য,
    // যাতে "আমার রিপোর্ট" থেকে যেকোনো ডিভাইসে আবার গণনা করে নামানো যায়।
    // · লগইন ছাড়াও কেনা যায় বলে create-এ auth লাগে না (uid:null) — orders-এর মতোই।
    // · uid থাকলে কেবল নিজের; পড়া কেবল নিজের বা অ্যাডমিনের।
    // · update কেবল একটাই: uid-বিহীন এন্ট্রি লগইনের পর নিজের নামে তোলা (claim)।
    //   ডকুমেন্টের id ২০ অক্ষরের এলোমেলো, থাকে কেবল ক্রেতার ব্রাউজারে।
    // ⚠️ এটা টাকার প্রমাণ নয় — pid যাচাই অ্যাডমিনের "যাচাই" বোতামে (payments/{pid})।
    match /purchases/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['product', 'state', 'label', 'pid', 'amount', 'lang', 'uid', 'ts'])
                    && request.resource.data.product in ['kundali', 'match', 'numerology', 'varshaphala', 'panjika']
                    && request.resource.data.state is map
                    && request.resource.data.state.size() <= 20
                    && request.resource.data.label is string && request.resource.data.label.size() <= 200
                    && request.resource.data.pid is string && request.resource.data.pid.size() <= 64
                    && request.resource.data.ts == request.time
                    && (request.resource.data.uid == null
                        || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if request.auth != null
                    && resource.data.uid == null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);
      allow delete: if isAdmin();
    }
  }
}
