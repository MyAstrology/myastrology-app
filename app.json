{
  "expo": {
    "name": "MyAstrology",
    "slug": "myastrology",
    "scheme": "myastrology",
    "version": "1.0.8",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "assets/fonts/**",
      "assets/panjika/**"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2678cdd7-fa10-4b80-8aa5-f276b88a51a3"
    },
    "android": {
      "package": "in.myastrology.app",
      "versionCode": 9,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8DFCB"
      },
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "myastrology.in" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "in.myastrology.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-full.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FEFAF2"
        }
      ],
      "./plugins/withDisableAdId.js",
      "./plugins/withGradleMemory.js",
      "./plugins/withFixReactGradleProps.js",
      "./plugins/withFixUserLeaveHintCrash.js",
      "./plugins/withR8.js"
    ],
    "extra": {
      "eas": {
        "projectId": "2678cdd7-fa10-4b80-8aa5-f276b88a51a3"
      }
    }
  }
}
