{"name":"Test Reader","info":"","html":"\n\n  <!-- ✦ Print Cover Page (screen-এ hidden, print-এ দেখাবে) ✦ -->\n  <!-- /printCoverPage -->\n\n  <!-- ✦ নবগ্রহ স্তোত্রম্ (print-only page 2) ✦ -->\n  <!-- /navagrahaStotraPage -->\n\n  <div id=\"ganeshabanner\" style=\"margin:0 0 16px 0\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 560 120\" width=\"100%\" style=\"display:block;border-radius:12px;box-shadow:0 2px 16px rgba(180,140,30,.22)\">\n      <rect width=\"560\" height=\"120\" rx=\"10\" fill=\"#FFFCF8\" stroke=\"#D4AF37\" stroke-width=\"1.5\"></rect>\n      <rect x=\"6\" y=\"6\" width=\"548\" height=\"108\" rx=\"6\" fill=\"none\" stroke=\"#D4AF37\" stroke-width=\"1\" stroke-dasharray=\"4 4\"></rect>\n      <rect x=\"9\" y=\"9\" width=\"542\" height=\"102\" rx=\"4\" fill=\"none\" stroke=\"#E5C158\" stroke-width=\"0.5\"></rect>\n      \n      <path d=\"M 125 18 L 125 102\" stroke=\"#D4AF37\" stroke-width=\"1\" stroke-dasharray=\"3 3\"></path>\n      <circle cx=\"125\" cy=\"60\" r=\"2.5\" fill=\"#D4AF37\"></circle>\n      \n      <path d=\"M 435 18 L 435 102\" stroke=\"#D4AF37\" stroke-width=\"1\" stroke-dasharray=\"3 3\"></path>\n      <circle cx=\"435\" cy=\"60\" r=\"2.5\" fill=\"#D4AF37\"></circle>\n\n      <g transform=\"translate(65, 60)\">\n        <circle cx=\"0\" cy=\"0\" r=\"32\" fill=\"#FDF2E9\"></circle>\n        <circle cx=\"0\" cy=\"0\" r=\"27\" fill=\"none\" stroke=\"#F5CBA7\" stroke-width=\"1\" stroke-dasharray=\"2 3\"></circle>\n        <g transform=\"scale(0.26) translate(-100,-100)\">\n          <path d=\"M 100,20 L 100,180\n                   M 20,100 L 180,100\n                   M 100,20 L 180,20\n                   M 180,100 L 180,180\n                   M 100,180 L 20,180\n                   M 20,100 L 20,20\" stroke=\"#900C3F\" stroke-width=\"16\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"></path>\n          <circle cx=\"60\" cy=\"60\" r=\"7\" fill=\"#900C3F\"></circle>\n          <circle cx=\"140\" cy=\"60\" r=\"7\" fill=\"#900C3F\"></circle>\n          <circle cx=\"60\" cy=\"140\" r=\"7\" fill=\"#900C3F\"></circle>\n          <circle cx=\"140\" cy=\"140\" r=\"7\" fill=\"#900C3F\"></circle>\n        </g>\n        <text x=\"0\" y=\"41\" text-anchor=\"middle\" font-family=\"'Noto Sans Bengali',sans-serif\" font-size=\"8\" fill=\"#9C640C\" font-weight=\"bold\">স্বস্তিক</text>\n      </g>\n\n      <g transform=\"translate(170, 60)\">\n        <circle cx=\"0\" cy=\"0\" r=\"34\" fill=\"#FDF2E9\"></circle>\n        <circle cx=\"0\" cy=\"0\" r=\"29\" fill=\"none\" stroke=\"#F5CBA7\" stroke-width=\"1\" stroke-dasharray=\"2 3\"></circle>\n        <circle cx=\"0\" cy=\"0\" r=\"23\" fill=\"none\" stroke=\"#F5CBA7\" stroke-width=\"0.5\"></circle>\n        <g stroke=\"#F5CBA7\" stroke-width=\"1\" stroke-linecap=\"round\">\n          <line x1=\"0\" y1=\"-23\" x2=\"0\" y2=\"-27\"></line><line x1=\"0\" y1=\"23\" x2=\"0\" y2=\"27\"></line>\n          <line x1=\"-23\" y1=\"0\" x2=\"-27\" y2=\"0\"></line><line x1=\"23\" y1=\"0\" x2=\"27\" y2=\"0\"></line>\n          <line x1=\"-16\" y1=\"-16\" x2=\"-19\" y2=\"-19\"></line><line x1=\"16\" y1=\"16\" x2=\"19\" y2=\"19\"></line>\n          <line x1=\"-16\" y1=\"16\" x2=\"-19\" y2=\"19\"></line><line x1=\"16\" y1=\"-16\" x2=\"19\" y2=\"-19\"></line>\n        </g>\n        <g stroke=\"#900C3F\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\">\n          <path d=\"M -8,-6 C -28,-18 -32,15 -6,12\"></path>\n          <path d=\"M 8,-6 C 28,-18 32,15 6,12\"></path>\n          <path d=\"M -8,-6 C -8,-22 8,-22 8,-6 C 8,6 1,12 1,22 C 1,32 12,32 12,22\"></path>\n          <path d=\"M -5,0 Q -3,-2 -1,0\" stroke-width=\"1.5\"></path>\n          <path d=\"M 5,0 Q 3,-2 1,0\" stroke-width=\"1.5\"></path>\n          <line x1=\"-5\" y1=\"8\" x2=\"-8\" y2=\"10\" stroke-width=\"1.5\"></line>\n          <line x1=\"5\" y1=\"8\" x2=\"9\" y2=\"12\" stroke-width=\"1.5\"></line>\n          <path d=\"M -6,-13 L 0,-26 L 6,-13 Z\" fill=\"#FFC300\" stroke=\"#FFC300\" stroke-width=\"1.5\"></path>\n          <circle cx=\"0\" cy=\"-26\" r=\"2\" fill=\"#900C3F\" stroke=\"none\"></circle>\n          <line x1=\"0\" y1=\"-8\" x2=\"0\" y2=\"-5\" stroke=\"#FFC300\" stroke-width=\"2\"></line>\n        </g>\n      </g>\n\n      <g font-family=\"'Noto Sans Bengali','SolaimanLipi',sans-serif\" text-anchor=\"middle\">\n        <text x=\"320\" y=\"33\" font-size=\"16\" font-weight=\"bold\" fill=\"#7B241C\">ওঁ শ্রী গণেশায় নমঃ</text>\n        <text x=\"320\" y=\"53\" font-size=\"11\" font-weight=\"bold\" fill=\"#B9770E\">বিঘ্নহর্তা শ্রী গণেশের চরণে প্রণাম</text>\n        <text x=\"320\" y=\"71\" font-size=\"10\" fill=\"#6E2C00\">সকল গ্রহ দোষ নাশক · শুভ সিদ্ধি প্রদায়ক</text>\n        <text x=\"320\" y=\"90\" font-family=\"serif\" font-size=\"11\" fill=\"#9C640C\" font-weight=\"bold\" letter-spacing=\"1\">ॐ श्री गणेशाय नमः</text>\n      </g>\n\n      <g transform=\"translate(495, 60)\">\n        <circle cx=\"0\" cy=\"0\" r=\"34\" fill=\"#FDF2E9\"></circle>\n        <circle cx=\"0\" cy=\"0\" r=\"29\" fill=\"none\" stroke=\"#F5CBA7\" stroke-width=\"1\" stroke-dasharray=\"2 3\"></circle>\n        <circle cx=\"0\" cy=\"0\" r=\"23\" fill=\"none\" stroke=\"#F5CBA7\" stroke-width=\"0.5\"></circle>\n        <g stroke=\"#F5CBA7\" stroke-width=\"1\" stroke-linecap=\"round\">\n          <line x1=\"0\" y1=\"-23\" x2=\"0\" y2=\"-27\"></line><line x1=\"0\" y1=\"23\" x2=\"0\" y2=\"27\"></line>\n          <line x1=\"-23\" y1=\"0\" x2=\"-27\" y2=\"0\"></line><line x1=\"23\" y1=\"0\" x2=\"27\" y2=\"0\"></line>\n          <line x1=\"-16\" y1=\"-16\" x2=\"-19\" y2=\"-19\"></line><line x1=\"16\" y1=\"16\" x2=\"19\" y2=\"19\"></line>\n          <line x1=\"-16\" y1=\"16\" x2=\"-19\" y2=\"19\"></line><line x1=\"16\" y1=\"-16\" x2=\"19\" y2=\"-19\"></line>\n        </g>\n        <text x=\"0\" y=\"11\" text-anchor=\"middle\" font-family=\"serif\" font-size=\"30\" fill=\"#7B241C\" font-weight=\"bold\">ॐ</text>\n      </g>\n      <text x=\"495\" y=\"103\" text-anchor=\"middle\" font-family=\"'Noto Sans Bengali',sans-serif\" font-size=\"8\" fill=\"#9C640C\" font-weight=\"bold\">ওঁকার</text>\n      \n    </svg>\n</div>\n\n    <!-- চার্ট -->\n    <div id=\"mainKundaliSection\" role=\"tabpanel\">\n    <!-- ✦ PDF (প্রবেশ-স্তর) প্রোমো ব্যানার ✦ ─────────────────────────\n         ৩/৯/২০২৬: প্রিমিয়াম ও সমাধানের বড় কার্ড ছিল, নমুনা PDF দেখার\n         বোতামও ছিল — আর সবচেয়ে সস্তা, সবচেয়ে সহজ, সবচেয়ে বেশি বিক্রি\n         হওয়ার কথা যেটির, তার কোনো দোকানই ছিল না; কেবল উপরে একটা আইকন।\n\n         তিনটে কার্ডের গড়ন ইচ্ছাকৃতভাবে এক — ব্যাজ · শিরোনাম · এক লাইনে\n         \"কী পাবেন + দাম\" · বোতাম। এক ছাঁচে থাকলে পাঠক চোখ নিচে নামিয়ে\n         তুলনা করতে পারেন, অর্থাৎ তুলনা-টেবিলের সুবিধাটা পাওয়া যায় —\n         কিন্তু ফোনে তিন কলামের বাংলা টেবিলের সংকীর্ণতা ছাড়াই।\n\n         ⚠️ নমুনা PDF-টা আগে থেকেই ছিল (_openSamplePdf('normal')), কিন্তু\n         বসানো ছিল **পেমেন্টের পপ-আপের ভিতরে** — অর্থাৎ যিনি ইতিমধ্যে\n         কিনতে রাজি, কেবল তিনিই দেখতে পেতেন। যেটা দ্বিধা কাটানোর জিনিস,\n         সেটাই দ্বিধার ওপারে রাখা ছিল। -->\n    <div class=\"card premium-promo pdf-promo\" data-offer=\"pdf\">\n      <div class=\"premium-promo-badge\">⚡ পেমেন্টের সঙ্গে সঙ্গেই</div>\n      <div class=\"premium-promo-icon\" aria-hidden=\"true\">📄</div>\n      <div class=\"premium-promo-text\">\n        <div class=\"premium-promo-title\">সম্পূর্ণ জন্মকোষ্ঠী PDF — ৭০+ পাতা</div>\n        <div class=\"premium-promo-sub\">উপরের পুরো গণনা — রাশিচক্র, গ্রহ, নক্ষত্র, দশা ও ফলাদেশ — ছাপার উপযোগী সাজানো PDF-এ, সঙ্গে সঙ্গে <span class=\"premium-promo-new mya-px-pdf\">₹১০১</span></div>\n        \n      </div>\n      \n    </div>\n    <!-- ✦ প্রিমিয়াম রিপোর্ট প্রোমো ব্যানার ✦ -->\n    <!-- ভাষা-নিয়ন্ত্রণ এখন js/offer-langs.js-এ — data-offer=\"pdf\" মানে\n         MYA_OFFER_LANGS.pdf-এ ভাষাটা থাকলে তবেই ব্যানার দেখা যায় -->\n    <div class=\"card premium-promo\" data-offer=\"pdf\">\n      <div class=\"premium-promo-badge\">⭐ ৫.০ · <span data-sd=\"total_reviews\">৩০৭+</span> যাচাইকৃত গ্রাহক</div>\n      <div class=\"premium-promo-icon\" aria-hidden=\"true\">💎</div>\n      <div class=\"premium-promo-text\">\n        <div class=\"premium-promo-title\"><span id=\"prmPromoName\"></span>১০০+ পাতার প্রিমিয়াম কোষ্ঠী বিশ্লেষণ</div>\n        <div class=\"premium-promo-sub\">ড. প্রদ্যুৎ আচার্যের ব্যক্তিগত বিশ্লেষণ + ৫টি প্রশ্নের উত্তর ও প্রতিকার — <span class=\"premium-promo-old\">₹৯৯৯</span><span class=\"premium-promo-new mya-px-prm\">₹৫০১</span></div>\n      </div>\n      \n    </div>\n    <!-- ✦ সম্পূর্ণ সমাধান প্যাকেজ প্রোমো ব্যানার ✦ -->\n    <!-- ২০২৬-০৮-২৫: আর লুকানো নয়। মালিকের নির্দেশ — যিনি ইংরেজি PDF\n         কিনে বাংলা/হিন্দিতে বুঝে নিতে চান, তাঁর জন্যই এই ব্যবস্থা।\n         data-offer=\"pdf+phone\" → ব্যানার দেখা যায়, আর টাকা কাটার আগে\n         _offerConfirmPhone() ফোনের ভাষাটা স্পষ্ট করে জানিয়ে দেয় -->\n    <div class=\"card premium-promo csp-promo\" data-offer=\"pdf+phone\">\n      <div class=\"premium-promo-badge\">🌟 সর্বোচ্চ ব্যক্তিগত সেবা</div>\n      <div class=\"premium-promo-icon\" aria-hidden=\"true\">🤝</div>\n      <div class=\"premium-promo-text\">\n        <div class=\"premium-promo-title\">সম্পূর্ণ সমাধান প্যাকেজ — প্রিমিয়াম রিপোর্ট + হস্তরেখা + সরাসরি কথা</div>\n        <div class=\"premium-promo-sub\">প্রিমিয়াম জন্মকোষ্ঠী + হস্তরেখা বিশ্লেষণ + ড. প্রদ্যুৎ আচার্যের সাথে ২০ মিনিট ব্যক্তিগত কনসালটেশন — <span class=\"premium-promo-new mya-px-csp\">₹১৫০১</span></div>\n      </div>\n      \n    </div>\n    <!-- ইংরেজি দর্শকের জন্য সৎ ঘোষণা — উপরের দুটো পেইড ব্যানার তখন লুকানো\n         থাকে, তাই এখানে খোলাখুলি কারণটা লেখা থাকে (নাহলে দর্শক ভাববেন\n         কিছু ভেঙে গেছে) -->\n    \n    <!-- হিন্দিতেও একই কারণ — ফোনে হিন্দি চলবে, কিন্তু রিপোর্টের লেখা\n         ইঞ্জিন এখনো বাংলাতেই তৈরি করে -->\n    \n    <!-- পঞ্চাঙ্গ সারসংক্ষেপ -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line></svg> জন্মকালীন পঞ্চাঙ্গ</h2>\n      <div class=\"pg-grid\">\n        <div class=\"pg-item\"><div class=\"lbl\">বার</div><div class=\"val\" id=\"pgVar\">—</div></div>\n        <div class=\"pg-item\"><div class=\"lbl\">জন্ম রাশি</div><div class=\"val\" id=\"pgSunRashi\">—</div></div>\n        <div class=\"pg-item\"><div class=\"lbl\">লগ্ন</div><div class=\"val\" id=\"pgLagna\">—</div></div>\n        <div class=\"pg-item\"><div class=\"lbl\">জন্ম নক্ষত্র</div><div class=\"val\" id=\"pgNakshatra\">—</div></div>\n        <div class=\"pg-item\"><div class=\"lbl\">যোগ</div><div class=\"val\" id=\"pgYoga\">—</div></div>\n        <div class=\"pg-item\"><div class=\"lbl\">তিথি</div><div class=\"val\" id=\"pgTithi\">—</div></div>\n      </div>\n      <div style=\"text-align:center;margin-top:10px;font-size:.88rem;color:#5c3d2e\">\n        অয়নাংশ (লাহিড়ী): <strong id=\"pgAyan\">—</strong>° &nbsp;|&nbsp; গণ: <strong id=\"pgGana\">—</strong>\n      </div>\n    </div>\n    <!-- ছকের ধরন — পূর্ব ভারতীয় (রাশি স্থির) না উত্তর ভারতীয় (ভাব স্থির)।\n         হিন্দি/ইংরেজিতে খুললে উত্তর ভারতীয়টাই আগে থেকে বাছা থাকে। -->\n    <div style=\"text-align:center;margin:0 0 10px\">\n      \n    </div>\n    <div class=\"chart-section\">\n      <div class=\"chart-box\">\n        <svg id=\"d1Chart\" width=\"300\" height=\"300\" viewBox=\"0 0 320 320\">\n            <g id=\"d1Frame\"></g>\n            <g id=\"d1Labels\"></g><g id=\"d1Planets\"></g>\n        </svg>\n      </div>\n      <div class=\"chart-box\">\n        <svg id=\"d9Chart\" width=\"300\" height=\"300\" viewBox=\"0 0 320 320\">\n            <g id=\"d9Frame\"></g>\n            <g id=\"d9Labels\"></g><g id=\"d9Planets\"></g>\n        </svg>\n      </div>\n    </div>\n    <div style=\"text-align:center;font-size:.74rem;color:#897358;margin:-10px 0 18px\">\n      <sup style=\"color:#9a7b3a;font-weight:700\">১-২৭</sup> = জন্ম নক্ষত্র নম্বর &nbsp;·&nbsp; <sup style=\"color:#c62828;font-weight:900\">ᴿ</sup> = বক্রী (Retrograde) গ্রহ &nbsp;·&nbsp; <sup style=\"color:#c8860a;font-weight:900\">★</sup> = বর্গোত্তম গ্রহ (D1=D9)<span id=\"northLegend\" hidden=\"\"> &nbsp;·&nbsp; <b style=\"color:#9a7b3a\">১</b><span style=\"color:#bfa375\">·৪</span> = ভাবের নম্বর · রাশির নম্বর</span>\n    </div>\n\n    <!-- গ্রহ সারণী -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"></line><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"></path></svg> গ্রহের অবস্থান</h2>\n      <div style=\"overflow-x:auto\" tabindex=\"0\">\n        <table class=\"planet-table\">\n          <thead><tr><th>গ্রহ</th><th>রাশি</th><th>ডিগ্রি</th><th>নক্ষত্র (পদ)</th><th>ভাব</th></tr></thead>\n          <tbody id=\"planetTbody\"></tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- গ্রহের দৃষ্টি ও শত্রু মিত্র -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg> গ্রহের দৃষ্টি ও শত্রু-মিত্র</h2>\n      <div style=\"overflow-x:auto\" id=\"aspectTableDiv\" tabindex=\"0\"></div>\n    </div>\n    </div><!-- /mainKundaliSection -->\n\n    <!-- ট্যাব নেভিগেশন -->\n    <div id=\"tabNav\" data-i18n-scope=\"tabs\" role=\"tablist\" aria-label=\"কুন্ডলি বিভাগ নেভিগেশন\" style=\"position:fixed;top:66px;left:0;right:0;z-index:800;background:#fffaf4;border-bottom:2px solid var(--gold);padding:8px 10px;overflow-x:auto;white-space:nowrap;display:flex;gap:6px;-webkit-overflow-scrolling:touch;scrollbar-width:thin\" tabindex=\"0\">\n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n      \n    </div>\n\n    <!-- Tab ক: ভাব কুণ্ডলি -->\n    <div id=\"tabBhava\" role=\"tabpanel\" class=\"tab-panel\">\n    <!-- ভাব কুণ্ডলী (চলিত) -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg> ভাব কুণ্ডলী (চলিত)</h2>\n      <div style=\"text-align:center;margin-bottom:12px\">\n        <div class=\"chart-box\" style=\"display:inline-block;margin:0 auto\">\n          <!-- ⚠️ ছকের কাঠামো এখানে হাতে লেখা নেই — chartFrame() বসায়, তাই\n               শৈলী (পূর্ব/উত্তর/দক্ষিণ) বদলালে এই ছকও বদলায়। আগে হাতে লেখা\n               ছিল বলে ভাব চক্র সবসময় পূর্ব ভারতীয়ই থেকে যেত। -->\n          <svg id=\"chalitChart\" width=\"300\" height=\"300\" viewBox=\"0 0 320 320\">\n            <g id=\"chalitFrame\"></g>\n            <g id=\"chalitLabels\"></g><g id=\"chalitPlanets\"></g>\n          </svg>\n        </div>\n      </div>\n      <div style=\"overflow-x:auto;margin-top:12px\" id=\"chalitTable\" tabindex=\"0\"></div>\n    </div>\n    <!-- ষড়বল -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg> ষড়বল (গ্রহের শক্তি)</h2>\n      <div style=\"overflow-x:auto\" id=\"shadbalaDiv\" tabindex=\"0\"></div>\n      <div id=\"shadbalaBarDiv\" style=\"margin-top:16px\"></div>\n    </div>\n    <!-- গ্রহের ভাব ফল -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg> গ্রহের ভাব ফলাদেশ</h2>\n      <div id=\"planetHousePredDiv\"></div>\n    </div>\n    <!-- গ্রহের যুতি ও দৃষ্টি ফলাদেশ -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"></path><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"></path></svg> গ্রহের যুতি ও দৃষ্টি ফলাদেশ</h2>\n      <div id=\"yutiDrishtiPredDiv\"></div>\n    </div>\n    <!-- মাঙ্গলিক ও কালসর্প দোষ বিচার -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg> মাঙ্গলিক ও কালসর্প দোষ বিচার</h2>\n      <div id=\"doshaDiv\"></div>\n    </div>\n    <!-- শনির সাড়েসাতি -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"></line><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"></path></svg> শনির সাড়েসাতি (Sade Sati)</h2>\n      <div style=\"overflow-x:auto\" id=\"sadeSatiDiv\" tabindex=\"0\"></div>\n    </div>\n    <!-- যোগ -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 3-1.9 5.8a2 2 0 0 1-1.287 1.288L3 12l5.8 1.9a2 2 0 0 1 1.288 1.287L12 21l1.9-5.8a2 2 0 0 1 1.287-1.288L21 12l-5.8-1.9a2 2 0 0 1-1.288-1.287Z\"></path></svg> কোষ্ঠীগত যোগ</h2>\n      <div style=\"overflow-x:auto\" id=\"lagnaNatureDiv\" tabindex=\"0\"></div>\n      <div style=\"overflow-x:auto\" id=\"yogaDiv\" tabindex=\"0\"></div>\n    </div>\n    </div><!-- /tabBhava -->\n\n    <!-- Tab খ: গোচর কুণ্ডলি -->\n    <div id=\"tabGochar\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"></path></svg> গোচর কুণ্ডলি (আজকের গ্রহ অবস্থান)</h2>\n      <div style=\"text-align:center;margin-bottom:12px\">\n        <div class=\"chart-box\" style=\"display:inline-block;margin:0 auto\">\n          <svg id=\"gocharChart\" width=\"300\" height=\"300\" viewBox=\"0 0 320 320\">\n            <g id=\"gocharFrame\"></g>\n            <g id=\"gocharLabels\"></g><g id=\"gocharPlanets\"></g>\n          </svg>\n        </div>\n      </div>\n      <div style=\"overflow-x:auto;margin-top:12px\" id=\"gocharTable\" tabindex=\"0\"></div>\n    </div>\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21.21 15.89A10 10 0 1 1 8 2.83\"></path><path d=\"M22 12A10 10 0 0 0 12 2v10z\"></path></svg> গোচর ফলাদেশ (জন্ম চন্দ্র রাশি থেকে)</h2>\n      <div id=\"gocharPredDiv\" style=\"line-height:1.85;font-size:.93rem\"></div>\n    </div>\n    </div><!-- /tabGochar -->\n\n    <!-- Tab গ: পঞ্চাঙ্গ -->\n    <div id=\"tabPanchang\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div id=\"panchangJatakaCard\" class=\"card\" style=\"padding:0;overflow:hidden;margin-bottom:14px;display:none;border-top:3px solid #7B1A28\"></div>\n    <!-- panchangDetail hidden: needed by print page for data extraction only -->\n    <div id=\"panchangDetail\" style=\"display:none\"></div>\n    </div><!-- /tabPanchang -->\n\n    <!-- Tab ঘ: বিংশোত্তরী দশা -->\n    <div id=\"tabDasha\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 22h14\"></path><path d=\"M5 2h14\"></path><path d=\"M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22\"></path><path d=\"M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2\"></path></svg> বিংশোত্তরী দশা</h2>\n      <div class=\"dasha-info\" id=\"dashaInfo\"></div>\n      <div style=\"overflow-x:auto\" id=\"dashaAccordion\" tabindex=\"0\"></div>\n    </div>\n    </div><!-- /tabDasha -->\n\n    <!-- Tab ঙ: সাধারণ বৈশিষ্ট্য -->\n    <div id=\"tabLakshan\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div class=\"card\" id=\"lakshanCard\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg> সাধারণ বৈশিষ্ট্য</h2>\n      <div class=\"prediction-box\" id=\"lakshanaDiv\"></div>\n    </div>\n    <!-- বক্রী গ্রহ বিভাগ -->\n    <div class=\"card\" id=\"retrogradeSection\" style=\"display:none\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 2v6h6\"></path><path d=\"M21 12A9 9 0 0 0 6 5.3L3 8\"></path><path d=\"M21 22v-6h-6\"></path><path d=\"M3 12a9 9 0 0 0 15 6.7l3-2.7\"></path></svg> বক্রী গ্রহ বিশ্লেষণ</h2>\n    </div>\n    <!-- জৈমিনি চর কারক -->\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"M7 21h10\"></path><path d=\"M12 3v18\"></path><path d=\"M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2\"></path></svg> জৈমিনি চর কারক</h2>\n      <div id=\"jaiminiSection\">\n        <p style=\"color:#666;text-align:center;padding:12px;font-family:'Noto Sans Bengali',serif\">কুণ্ডলী গণনার পর চর কারক এখানে দেখাবে।</p>\n      </div>\n    </div>\n    <!-- নামকরণ -->\n    <div class=\"card\" id=\"namakaranSection\" style=\"display:none\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z\"></path></svg> নামকরণ — জন্ম নক্ষত্রের অক্ষর</h2>\n      <!-- নামের অক্ষরগুলোর মানে এখানে আলাদা (\"মে\" = নামের অক্ষর Me,\n           মাসের নাম May নয়) — তাই আলাদা অভিধান, শুধু এই অংশে -->\n      <div id=\"namakaranContent\" data-i18n-scope=\"syllables\"></div>\n    </div>\n    </div><!-- /tabLakshan -->\n\n    <!-- Tab চ: দশাফল -->\n    <div id=\"tabDashaFal\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"></path><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"></path></svg> দশাফল ও