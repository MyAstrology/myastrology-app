x:auto\" tabindex=\"0\"></div>\n    </div>\n    <!-- প্রহর শাস্ত্রীয় বিশ্লেষণ -->\n    <div class=\"card\" style=\"margin-top:8px;border-left:3px solid #e65100\">\n      <h2 class=\"section-title\" style=\"color:#e65100\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg> প্রহর শাস্ত্রীয় বিশ্লেষণ</h2>\n      <p style=\"font-size:.78rem;color:#555;margin:0 0 10px;line-height:1.65\">জন্ম বার ও প্রহর অনুযায়ী শাস্ত্রীয় বিচার। বারেশ ও প্রহরেশের যুগ্মপ্রভাবে জাতকের স্বভাব, স্বাস্থ্য, পেশা ও দাম্পত্য নির্ধারিত।</p>\n      <div id=\"praharaDiv\"></div>\n    </div>\n    </div><!-- /tabLifePred -->\n\n  <!-- ✦ বর্গ চার্ট ট্যাব ✦ -->\n  <div id=\"tabVargaChart\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"></rect><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"></rect><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"></rect><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"></rect></svg> বর্গ চার্ট বিশ্লেষণ</h2>\n\n      <!-- চার চার্ট ২×২ গ্রিড -->\n      <div style=\"display:flex;flex-wrap:wrap;gap:16px;justify-content:center;margin-bottom:16px\">\n\n        <!-- D-2 হোরা -->\n        <div style=\"flex:0 0 auto;text-align:center\">\n          <div style=\"font-size:.8rem;font-weight:700;color:#2e7d32;margin-bottom:4px;font-family:'Noto Sans Bengali',serif\">D-2 হোরা (অর্থ)</div>\n          <div class=\"chart-box\" style=\"display:inline-block\">\n            <svg id=\"d2Chart\" width=\"280\" height=\"280\" viewBox=\"0 0 320 320\">\n              <g id=\"d2Frame\"></g><g id=\"d2Labels\"></g><g id=\"d2Planets\"></g>\n            </svg>\n          </div>\n        </div>\n\n        <!-- D-7 সপ্তমাংশ -->\n        <div style=\"flex:0 0 auto;text-align:center\">\n          <div style=\"font-size:.8rem;font-weight:700;color:#6a1b9a;margin-bottom:4px;font-family:'Noto Sans Bengali',serif\">D-7 সপ্তমাংশ (সন্তান)</div>\n          <div class=\"chart-box\" style=\"display:inline-block\">\n            <svg id=\"d7Chart\" width=\"280\" height=\"280\" viewBox=\"0 0 320 320\">\n              <g id=\"d7Frame\"></g><g id=\"d7Labels\"></g><g id=\"d7Planets\"></g>\n            </svg>\n          </div>\n        </div>\n\n        <!-- D-10 দশমাংশ -->\n        <div style=\"flex:0 0 auto;text-align:center\">\n          <div style=\"font-size:.8rem;font-weight:700;color:#0d47a1;margin-bottom:4px;font-family:'Noto Sans Bengali',serif\">D-10 দশমাংশ (কর্ম)</div>\n          <div class=\"chart-box\" style=\"display:inline-block\">\n            <svg id=\"d10Chart\" width=\"280\" height=\"280\" viewBox=\"0 0 320 320\">\n              <g id=\"d10Frame\"></g><g id=\"d10Labels\"></g><g id=\"d10Planets\"></g>\n            </svg>\n          </div>\n        </div>\n\n        <!-- D-12 দ্বাদশাংশ -->\n        <div style=\"flex:0 0 auto;text-align:center\">\n          <div style=\"font-size:.8rem;font-weight:700;color:#4e342e;margin-bottom:4px;font-family:'Noto Sans Bengali',serif\">D-12 দ্বাদশাংশ (পিতা-মাতা)</div>\n          <div class=\"chart-box\" style=\"display:inline-block\">\n            <svg id=\"d12Chart\" width=\"280\" height=\"280\" viewBox=\"0 0 320 320\">\n              <g id=\"d12Frame\"></g><g id=\"d12Labels\"></g><g id=\"d12Planets\"></g>\n            </svg>\n          </div>\n        </div>\n\n      </div><!-- /charts grid -->\n\n      <!-- গ্রহ অবস্থান সারণী -->\n      <div class=\"card\" style=\"margin-top:8px\">\n        <h3 class=\"section-title\" style=\"font-size:.9rem\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21.21 15.89A10 10 0 1 1 8 2.83\"></path><path d=\"M22 12A10 10 0 0 0 12 2v10z\"></path></svg> সকল বর্গ চার্টে গ্রহের অবস্থান</h3>\n        <div id=\"vargaTable\" style=\"overflow-x:auto;margin-top:8px\" tabindex=\"0\"></div>\n      </div>\n\n      <!-- ভবিষ্যদ্বাণী বিভাগ -->\n      <div class=\"card\" style=\"margin-top:8px;border-left:3px solid #2e7d32\">\n        <h3 class=\"section-title\" style=\"font-size:.9rem;color:#2e7d32\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12V7H5a2 2 0 0 1 0-4h14v4\"></path><path d=\"M3 5v14a2 2 0 0 0 2 2h16v-5\"></path><path d=\"M18 12a2 2 0 0 0 0 4h4v-4Z\"></path></svg> D-2 হোরা — অর্থ ও সম্পদ বিশ্লেষণ</h3>\n        <div id=\"d2Pred\" style=\"padding:8px 4px\"></div>\n      </div>\n\n      <div class=\"card\" style=\"margin-top:8px;border-left:3px solid #6a1b9a\">\n        <h3 class=\"section-title\" style=\"font-size:.9rem;color:#9c4dcc\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M8 14s1.5 2 4 2 4-2 4-2\"></path><line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"></line><line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"></line></svg> D-7 সপ্তমাংশ — সন্তান ও সৃজনশীলতা</h3>\n        <div id=\"d7Pred\" style=\"padding:8px 4px\"></div>\n      </div>\n\n      <div class=\"card\" style=\"margin-top:8px;border-left:3px solid #0d47a1\">\n        <h3 class=\"section-title\" style=\"font-size:.9rem;color:#1565c0\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12V7H5a2 2 0 0 1 0-4h14v4\"></path><path d=\"M3 5v14a2 2 0 0 0 2 2h16v-5\"></path><path d=\"M18 12a2 2 0 0 0 0 4h4v-4Z\"></path></svg> D-10 দশমাংশ — কর্মজীবন ও পেশা</h3>\n        <div id=\"d10Pred\" style=\"padding:8px 4px\"></div>\n      </div>\n\n      <div class=\"card\" style=\"margin-top:8px;border-left:3px solid #4e342e\">\n        <h3 class=\"section-title\" style=\"font-size:.9rem;color:#6d4c41\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg> D-12 দ্বাদশাংশ — পিতা-মাতা ও পূর্ব কর্ম</h3>\n        <div id=\"d12Pred\" style=\"padding:8px 4px\"></div>\n      </div>\n\n      <!-- D-9 প্রিমিয়াম বিশ্লেষণ -->\n      <div class=\"card\" style=\"margin-top:8px;border-left:3px solid #7b1fa2\">\n        <h3 class=\"section-title\" style=\"font-size:.9rem;color:#7b1fa2\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 3h12l4 6-10 12L2 9z\"></path><path d=\"M11 3 8 9l4 12 4-12-3-6\"></path><path d=\"M2 9h20\"></path></svg> D-9 নবমাংশ বিশেষ বিশ্লেষণ — বিবাহ ও ভাগ্য</h3>\n        <div id=\"navamshaAnalysisDiv\" style=\"padding:4px 0;font-family:'Noto Sans Bengali',serif;font-size:.84rem;line-height:1.7;color:#2a1a0e\"></div>\n      </div>\n\n    </div>\n  </div><!-- /tabVargaChart -->\n\n  <!-- ✦ অষ্টকবর্গ ট্যাব ✦ -->\n  <div id=\"tabAshtakavarga\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div class=\"card\" id=\"ashtakavargaContent\">\n      <p style=\"color:#666;text-align:center;padding:20px;font-family:'Noto Sans Bengali',serif\">কুণ্ডলী গণনার পর অষ্টকবর্গ এখানে দেখাবে।</p>\n    </div>\n  </div><!-- /tabAshtakavarga -->\n\n  <!-- ✦ গোচর ক্যালেন্ডার ✦ -->\n  <div id=\"tabTransitCal\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line></svg> আগামী ২ বছরের গোচর ক্যালেন্ডার</h2>\n      <div id=\"transitCalendarContent\">\n        <p style=\"color:#666;text-align:center;padding:20px;font-family:'Noto Sans Bengali',serif\">কুণ্ডলী গণনার পর গোচর ক্যালেন্ডার এখানে দেখাবে।</p>\n      </div>\n    </div>\n  </div><!-- /tabTransitCal -->\n\n  <!-- ✦ সর্বতোভদ্র চক্র ✦ -->\n  <div id=\"tabSBC\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polygon points=\"16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76\"></polygon></svg> সর্বতোভদ্র চক্র</h2>\n      <p style=\"font-size:.82rem;color:#555;margin:0 0 12px;font-family:'Noto Sans Bengali',serif;line-height:1.65\">\n        ৯×৯ গ্রিডে ২৭ নক্ষত্র সাজানো। সোনালি = জন্ম নক্ষত্র · নীল = আজকের গোচর · লাল আভা = বেধ নক্ষত্র।\n      </p>\n      <div id=\"sbcContent\">\n        <p style=\"color:#666;text-align:center;padding:20px;font-family:'Noto Sans Bengali',serif\">কুণ্ডলী গণনার পর সর্বতোভদ্র চক্র এখানে দেখাবে।</p>\n      </div>\n    </div>\n  </div><!-- /tabSBC -->\n\n  <!-- ✦ K.P. System ✦ -->\n  <div id=\"tabKP\" role=\"tabpanel\" class=\"tab-panel\" style=\"display:none\">\n    <div class=\"card\">\n      <h2 class=\"section-title\"><svg class=\"title-icon\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"></line><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"></path></svg> K.P. পদ্ধতি — কৃষ্ণমূর্তি নক্ষত্র সাব-লর্ড বিশ্লেষণ</h2>\n      <div id=\"kpContent\">\n        <p style=\"color:#666;text-align:center;padding:20px;font-family:'Noto Sans Bengali',serif\">কুণ্ডলী গণনার পর K.P. বিশ্লেষণ এখানে দেখাবে।</p>\n      </div>\n    </div>\n  </div><!-- /tabKP -->\n\n  <!-- ✦ বার্ষিক বর্ষফল — PDF পেজ (print-only) ✦ -->\n  <div id=\"varshaphalaPdfSection\" style=\"display:none\">\n    <div style=\"page-break-before:always;padding-top:8px\">\n      <div style=\"background:#1a3a1a;color:#ffd700;text-align:center;padding:10px 16px;font-family:Georgia,Georgia,serif;font-size:1.05rem;font-weight:700;letter-spacing:.1em;border-radius:6px 6px 0 0;border:1.5px solid #4a7a4a\">☀️ &nbsp;বার্ষিক বর্ষফল &nbsp;—&nbsp; তাজিক পদ্ধতি</div>\n      <div id=\"pdf_varsha_meta\" style=\"background:#f0f8f0;text-align:center;font-size:.8rem;color:#2a4a2a;padding:6px;border:1px solid #4a7a4a;border-top:none;margin-bottom:10px\"></div>\n      <div id=\"pdf_year_summary\" style=\"margin-bottom:10px\"></div>\n      <h3 class=\"section-title\" style=\"background:#2a4a2a!important\">বর্ষেশ ফলাদেশ</h3>\n      <div id=\"pdf_varshesha_meta\" style=\"font-size:.78rem;color:#3a5a3a;font-weight:700;padding:4px 0 6px;margin-bottom:4px\"></div>\n      <div class=\"prediction-box\" style=\"border-left-color:#4a7a4a!important\">\n        <div id=\"pdf_varshesha_text\" style=\"font-size:.82rem;line-height:1.75;color:#1a2a1a\"></div>\n      </div>\n      <h3 class=\"section-title\" style=\"background:#2a4a2a!important;margin-top:10px\">বর্ষচালিকা ফলাদেশ</h3>\n      <div id=\"pdf_muntha_meta\" style=\"font-size:.78rem;color:#3a5a3a;font-weight:700;padding:4px 0 6px;margin-bottom:4px\"></div>\n      <div class=\"prediction-box\" style=\"border-left-color:#4a7a4a!important\">\n        <div id=\"pdf_muntha_text\" style=\"font-size:.82rem;line-height:1.75;color:#1a2a1a\"></div>\n      </div>\n      <div id=\"pdf_punya_saham\" style=\"margin-top:8px\"></div>\n      <!-- মুদ্দা দশা (হায়নরত্ন) — বছরের ভেতর দশা-টাইমলাইন; JS দিয়ে populate হয় -->\n      <div id=\"pdf_mudda_dasha\" style=\